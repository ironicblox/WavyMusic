<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Wavy.Android.Views"
       x:Class="Wavy.Android.AppShell"
       Shell.NavBarIsVisible="False"
       FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent Title="Home"
                      Icon="tab_home.png"
                      ContentTemplate="{DataTemplate views:HomePage}"
                      Route="home" />
        <ShellContent Title="Search"
                      Icon="tab_search.png"
                      ContentTemplate="{DataTemplate views:SearchPage}"
                      Route="search" />
        <ShellContent Title="Library"
                      Icon="tab_library.png"
                      ContentTemplate="{DataTemplate views:PlaylistsPage}"
                      Route="library" />
        <ShellContent Title="Settings"
                      Icon="tab_settings.png"
                      ContentTemplate="{DataTemplate views:SettingsPage}"
                      Route="settings" />
    </TabBar>

</Shell>
