<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:Wavy.Android.Converters">

    <!-- Global converters available everywhere via StaticResource -->
    <conv:IsNotNullConverter   x:Key="IsNotNullConverter" />
    <conv:InvertBoolConverter  x:Key="InvertBoolConverter" />
    <conv:BoolToFontAttrConverter x:Key="BoolToFontAttrConverter" />
    <conv:LyricsOpacityConverter  x:Key="LyricsOpacityConverter" />
    <conv:SecondsToTimeConverter  x:Key="SecondsToTimeConverter" />

    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource WavyBg}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource WavySurface}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource WavyText}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource WavyText}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource WavySurface}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource WavySubtext}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource WavySubtext}" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WavyText}" />
        <Setter Property="FontFamily" Value="SegoeUI" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WavySubtext}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AccentLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="2" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="TextColor" Value="{StaticResource WavyBg}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="20,10" />
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="20,10" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{StaticResource WavyText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource WavySubtext}" />
        <Setter Property="BackgroundColor" Value="{StaticResource WavyCard}" />
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{StaticResource WavyText}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource WavySubtext}" />
        <Setter Property="BackgroundColor" Value="{StaticResource WavyCard}" />
        <Setter Property="CancelButtonColor" Value="{StaticResource WavyAccent}" />
    </Style>

    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource WavyCard}" />
        <Setter Property="BorderColor" Value="{StaticResource WavyDivider}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource WavyAccent}" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource WavyAccent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource WavyDivider}" />
        <Setter Property="ThumbColor" Value="{StaticResource WavyAccent}" />
    </Style>

</ResourceDictionary>
